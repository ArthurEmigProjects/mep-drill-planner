{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HombreOso/mep-drill-planner/data/mounting_elements/schema.json",
  "title": "MEP mounting-element database",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "products", "guidance"],
  "properties": {
    "schema_version": {"type": "integer"},
    "description": {"type": "string"},
    "products": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    },
    "guidance": {
      "type": "array",
      "items": {"$ref": "#/$defs/guidance"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": {"type": "string"},
        "url": {"type": "string", "minLength": 8},
        "accessed": {"type": "string"}
      }
    },
    "range_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "kind"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "kind": {"type": "string"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manufacturer",
        "product_line",
        "name",
        "article_number",
        "element_types",
        "role",
        "outer_diameter_mm",
        "nominal_diameter_mm",
        "connection_threads",
        "load_rating",
        "max_support_spacing",
        "anchor",
        "assumptions",
        "notes",
        "sources"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string"},
        "product_line": {"type": ["string", "null"]},
        "name": {"type": "string"},
        "article_number": {"type": ["string", "null"]},
        "element_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "pipe",
              "duct_round",
              "duct_rectangular",
              "duct_flex",
              "radiator",
              "threaded_rod",
              "channel",
              "ceiling_anchor"
            ]
          }
        },
        "role": {"enum": ["primary", "companion"]},
        "outer_diameter_mm": {"anyOf": [{"$ref": "#/$defs/range_mm"}, {"type": "null"}]},
        "nominal_diameter_mm": {"type": ["number", "null"]},
        "connection_threads": {
          "type": "array",
          "items": {"type": "string"}
        },
        "load_rating": {"anyOf": [{"$ref": "#/$defs/load"}, {"type": "null"}]},
        "max_support_spacing": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["horizontal_m", "source_note"],
                "properties": {
                  "horizontal_m": {"type": ["number", "null"]},
                  "vertical_m": {"type": ["number", "null"]},
                  "source_note": {"type": "string"}
                }
              }
            }
          ]
        },
        "anchor": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "thread", "substrate"],
              "properties": {
                "type": {"type": ["string", "null"]},
                "thread": {"type": ["string", "null"]},
                "substrate": {"type": ["string", "null"]},
                "included_fixings": {"type": ["string", "null"]},
                "notes": {"type": ["string", "null"]}
              }
            }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {"type": ["string", "null"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "applies_to", "rows", "notes", "sources"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "applies_to": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rows": {"type": "array"},
        "notes": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    }
  }
}
